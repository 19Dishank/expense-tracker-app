{
  "expo": {
    "name": "Expense Tracker",
    "slug": "ExpenseTracker",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.expensetracker.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Expense Tracker uses Face ID to keep your financial data private."
      }
    },
    "android": {
      "package": "com.expensetracker.app",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#1C1C1E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Expense Tracker to use Face ID to keep your data private."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 288,
          "resizeMode": "contain",
          "backgroundColor": "#F7F8FA",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#0E0F12"
          }
        }
      ]
    ]
  }
}
